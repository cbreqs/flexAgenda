
{
  "entities": {
    "Business": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Business",
      "type": "object",
      "description": "Represents a business using the platform.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "members": { 
          "type": "object",
          "description": "Map of user IDs to roles (admin, editor, viewer)."
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "members"]
    },
    "GrandClient": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GrandClient",
      "type": "object",
      "description": "A central record for an end-user client.",
      "properties": {
        "g-client_email": { "type": "string", "format": "email" },
        "g-client_first": { "type": "string" },
        "g-client_last": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["g-client_email"]
    },
    "BookingType": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "BookingType",
      "type": "object",
      "description": "A bookable service or event type.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "defaultDurationMinutes": { "type": "number" },
        "maxCapacity": { "type": "number" },
        "price": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "defaultDurationMinutes", "maxCapacity"]
    },
    "Booking": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Booking",
      "type": "object",
      "description": "A reservation made by a customer.",
      "properties": {
        "id": { "type": "string" },
        "bookingTypeId": { "type": "string" },
        "bookerName": { "type": "string" },
        "bookerEmail": { "type": "string", "format": "email" },
        "startTime": { "type": "string", "format": "date-time" },
        "bookingStatus": { "type": "string", "enum": ["confirmed", "cancelled", "pending"] }
      },
      "required": ["id", "bookingTypeId", "bookerName", "bookerEmail", "startTime", "bookingStatus"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/businesses/{businessId}",
        "definition": {
          "entityName": "Business",
          "schema": { "$ref": "#/backend/entities/Business" },
          "description": "Root business documents."
        }
      },
      {
        "path": "/grandclients/{clientId}",
        "definition": {
          "entityName": "GrandClient",
          "schema": { "$ref": "#/backend/entities/GrandClient" },
          "description": "Global end-user client information."
        }
      },
      {
        "path": "/businesses/{businessId}/bookingTypes/{typeId}",
        "definition": {
          "entityName": "BookingType",
          "schema": { "$ref": "#/backend/entities/BookingType" },
          "description": "Services offered by the business."
        }
      },
      {
        "path": "/businesses/{businessId}/bookings/{bookingId}",
        "definition": {
          "entityName": "Booking",
          "schema": { "$ref": "#/backend/entities/Booking" },
          "description": "Customer reservations."
        }
      }
    ]
  }
}
