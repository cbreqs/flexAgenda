
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(members, uid) {
      return members != null && uid in members && (members[uid] == 'admin' || members[uid] == 'editor' || members[uid] == 'viewer');
    }

    function isAdmin(members, uid) {
      return members != null && uid in members && members[uid] == 'admin';
    }

    // Businesses collection
    match /businesses/{businessId} {
      allow get: if true;
      // List permission requires the query to be filtered by the user's role in the members map
      allow list: if isSignedIn() && request.auth.uid in resource.data.members && resource.data.members[request.auth.uid] in ['admin', 'editor', 'viewer'];
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isAdmin(resource.data.members, request.auth.uid);

      match /bookingTypes/{typeId} {
        allow read: if true;
        allow write: if isSignedIn() && hasRole(get(/databases/$(database)/documents/businesses/$(businessId)).data.members, request.auth.uid);
      }

      match /bookings/{bookingId} {
        allow list: if isSignedIn() && hasRole(get(/databases/$(database)/documents/businesses/$(businessId)).data.members, request.auth.uid);
        allow get: if true;
        allow create: if true;
        allow update, delete: if isSignedIn() && hasRole(get(/databases/$(database)/documents/businesses/$(businessId)).data.members, request.auth.uid);
      }
    }

    // Grandclients collection (Centralized end-user data)
    match /grandclients/{clientId} {
      allow read: if true; // Public verification allowed
      allow create, update: if true; // Clients and users can manage records
      allow delete: if false;
    }
  }
}
