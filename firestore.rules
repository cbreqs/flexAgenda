rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- PROTOTYPING RULES (OPEN) ---
    // These rules allow any access. This ensures you can get the app running
    // and verify the connection without being blocked by permissions.
    // You should restrict these once your connection is confirmed.
    
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
