
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(members, uid) {
      return uid in members && (members[uid] == 'admin' || members[uid] == 'editor' || members[uid] == 'viewer');
    }

    function isAdmin(members, uid) {
      return uid in members && members[uid] == 'admin';
    }

    // New businesses collection
    match /businesses/{businessId} {
      allow get: if true;
      allow list: if isSignedIn() && hasRole(resource.data.members, request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isAdmin(resource.data.members, request.auth.uid);

      match /bookingTypes/{typeId} {
        allow read: if true;
        allow write: if isSignedIn() && hasRole(get(/databases/$(database)/documents/businesses/$(businessId)).data.members, request.auth.uid);
      }

      match /bookings/{bookingId} {
        allow list: if isSignedIn() && hasRole(get(/databases/$(database)/documents/businesses/$(businessId)).data.members, request.auth.uid);
        allow get: if true;
        allow create: if true;
        allow update, delete: if isSignedIn() && hasRole(get(/databases/$(database)/documents/businesses/$(businessId)).data.members, request.auth.uid);
      }
    }

    // New grandclients collection
    match /grandclients/{clientId} {
      allow read: if true; // Public can verify or check records
      allow create: if true; // Anyone booking can create a record
      allow update: if true; // Anyone booking can update their record
      allow delete: if false; // Only platform admins could delete (not defined yet)
    }
  }
}
