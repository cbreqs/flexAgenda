
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(members, uid) {
      return members != null && uid in members && (members[uid] == 'admin' || members[uid] == 'editor' || members[uid] == 'viewer');
    }

    function isAdmin(members, uid) {
      return members != null && uid in members && members[uid] == 'admin';
    }

    // Businesses collection
    match /businesses/{businessId} {
      // Public needs to see name/description to render the booking page
      allow get: if true;
      // List permission requires the query to be filtered by membership
      allow list: if isSignedIn() && request.auth.uid in resource.data.members;
      
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isAdmin(resource.data.members, request.auth.uid);

      match /bookingTypes/{typeId} {
        allow read: if true;
        allow write: if isSignedIn() && hasRole(get(/databases/$(database)/documents/businesses/$(businessId)).data.members, request.auth.uid);
      }

      match /bookings/{bookingId} {
        // Business owners see all. Grandclients see only theirs.
        allow list: if isSignedIn() && (
          hasRole(get(/databases/$(database)/documents/businesses/$(businessId)).data.members, request.auth.uid) ||
          (resource == null || resource.data.grandclientId == request.auth.uid)
        );
        allow get: if isSignedIn() && (
          hasRole(get(/databases/$(database)/documents/businesses/$(businessId)).data.members, request.auth.uid) ||
          resource.data.grandclientId == request.auth.uid
        );
        allow create: if true; // Allow anyone to request a booking (linked via grandclientId if logged in)
        allow update, delete: if isSignedIn() && hasRole(get(/databases/$(database)/documents/businesses/$(businessId)).data.members, request.auth.uid);
      }
    }

    // Grandclients collection (Centralized end-user data)
    // Users can only manage their own profile based on Auth UID
    match /grandclients/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
